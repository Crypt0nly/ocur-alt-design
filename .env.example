# ── /be-ai reverse Turing test ────────────────────────────────────────────────
# Where the interactive game endpoints live (the Ocur app stack). The public
# URL stays on the root domain: ocur.ai/be-ai/api/* is reverse-proxied to
# ${OCUR_APP_API_BASE}/api/be-ai/* (see next.config.mjs). Defaults to prod.
OCUR_APP_API_BASE=https://app.ocur.ai

# Where the "Try Ocur" conversion CTAs point (signup / product).
NEXT_PUBLIC_OCUR_CTA_URL=https://app.ocur.ai/?utm_source=be-ai
